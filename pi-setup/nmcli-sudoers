# Permite al servidor LinkBox ejecutar nmcli sin pedir contraseña.
# Necesario para que el widget de WiFi del dashboard pueda escanear
# y conectarse a redes.
#
# Instalación:
#   sudo cp nmcli-sudoers /etc/sudoers.d/linkbox-nmcli
#   sudo chmod 0440 /etc/sudoers.d/linkbox-nmcli
#   sudo visudo -c   (verifica que la sintaxis sea correcta)

pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli
